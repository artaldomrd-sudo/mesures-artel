rules_version = '2';

// Reglas de seguridad de Firestore para el proyecto artal-operaciones.
// Se pegan en Firebase Console → Firestore Database → pestaña "Reglas" → Publicar.
//
// - Todo usuario autenticado puede LEER.
// - Escriben todos EXCEPTO quien tenga el rol `lector` (a menos que también sea `admin`). El rol
//   vive en usuarios/{email}.rol y puede ser un string ('chofer') o un array (['chofer',...]).
// - Los registros de auditoría (movimientosInstalaciones, movimientosInventario) solo permiten
//   CREAR: una anotación ya hecha no se puede editar ni borrar (ni siquiera un admin) — historial
//   a prueba de manipulación. Por eso las colecciones se enumeran una por una en vez de usar un
//   `allow write` recursivo (que dejaría editar/borrar el log).
service cloud.firestore {
  match /databases/{database}/documents {

    function rolesDelUsuario() {
      let u = get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data;
      return u.rol is list ? u.rol : [u.rol];
    }
    function puedeEscribir() {
      return request.auth != null
        && ('admin' in rolesDelUsuario() || !('lector' in rolesDelUsuario()));
    }

    // Solicitud del formulario del sitio web: la crea el público SIN sesión, así que se valida a
    // mano (solo los campos esperados, con tipos y tamaños acotados) para no dejar entrar basura.
    function solicitudWebValida() {
      let d = request.resource.data;
      return d.origen == 'web'
        && d.estado == 'nueva'
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() < 120
        && d.telefono is string && d.telefono.size() < 40
        && d.email is string && d.email.size() < 160
        && d.tipo is string && d.tipo.size() < 200
        && d.mensaje is string && d.mensaje.size() < 3000
        && d.keys().hasOnly(['origen','estado','nombre','telefono','email','tipo','mensaje','fecha']);
    }

    // Todo se puede LEER estando autenticado — EXCEPTO `usuarios` (datos sensibles: PIN, biometría,
    // tokens, 2FA), que solo lee cada quien su propio doc o un admin (ver más abajo). Las pantallas
    // compartidas usan el espejo `equipo` (nombre, rol, activo), que lo mantiene una Cloud Function.
    match /{coleccion}/{resto=**} {
      allow read: if request.auth != null && coleccion != 'usuarios';
    }
    match /equipo/{email} {
      allow write: if false;   // solo la Cloud Function sincronizarEquipo (Admin SDK)
    }

    // Precios de combustible (MICM): los actualiza una Cloud Function semanal (Admin SDK, se salta
    // las reglas). Lectura PÚBLICA — son precios oficiales, no hay dato sensible — para que la
    // calculadora de transporte del cuaderno los lea aunque no haya sesión iniciada. Ningún cliente
    // puede escribir aquí.
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Registros de auditoría: SOLO se pueden CREAR. Nadie (ni admin) edita ni borra una anotación
    // ya hecha — historial a prueba de manipulación.
    match /movimientosInstalaciones/{id} { allow create: if puedeEscribir(); }
    match /movimientosInventario/{id}    { allow create: if puedeEscribir(); }

    // Colecciones normales: crear / editar / borrar para quien no sea "lector".
    match /orders/{id}               { allow write: if puedeEscribir(); }
    match /citas/{id}                { allow write: if puedeEscribir(); }
    match /instalaciones/{id}        { allow write: if puedeEscribir(); }
    match /inventario/{id}           { allow write: if puedeEscribir(); }
    match /categoriasInventario/{id} { allow write: if puedeEscribir(); }
    match /subgruposInventario/{id}  { allow write: if puedeEscribir(); }
    match /bultosHerramientas/{id}   { allow write: if puedeEscribir(); }
    match /clientes/{id}             { allow write: if puedeEscribir(); }
    // Usuarios y roles: CREAR/BORRAR y cambiar rol/nombre/activo solo un ADMIN (pantalla
    // usuarios.html). Cada persona puede actualizar SU propio documento solo en sus ajustes
    // personales (fcmToken, panelOrden, notifOcultas, PIN, biometría…), nunca su rol ni su estado.
    match /usuarios/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || 'admin' in rolesDelUsuario());
      allow create, delete: if request.auth != null && 'admin' in rolesDelUsuario();
      allow update: if request.auth != null && (
        'admin' in rolesDelUsuario()
        || (request.auth.token.email == email
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'activo', 'nombre', 'paginasExtra', 'paginasBloqueadas'])));
    }
    match /proyectosGuardados/{id}   { allow write: if puedeEscribir(); }
    // Historial de versiones del cuaderno (proyectosGuardados/{id}/versiones/{ts}): la lectura la
    // cubre el match general; la escritura NO se hereda del padre, hay que declararla aparte.
    match /proyectosGuardados/{id}/versiones/{v} { allow write: if puedeEscribir(); }
    match /equiposInstalacion/{id}   { allow write: if puedeEscribir(); }

    // Academia (capacitación): el CONTENIDO (cursos/lecciones) solo lo edita gerencia (admin) o el
    // rol 'capacitador'. El PROGRESO lo escribe cada quien sobre su propio avance (cualquier sesión).
    match /academiaCursos/{id}    { allow write: if request.auth != null && ('admin' in rolesDelUsuario() || 'capacitador' in rolesDelUsuario()); }
    match /academiaLecciones/{id} { allow write: if request.auth != null && ('admin' in rolesDelUsuario() || 'capacitador' in rolesDelUsuario()); }
    match /academiaProgreso/{id}  { allow write: if request.auth != null; }

    // Puntos (gamificación): ledger que alimenta el futuro módulo de Nivel/Rango. Cada quien solo
    // puede escribir eventos con SU propio correo (no puntos ajenos). Borrar, solo admin.
    match /puntos/{id} {
      allow create, update: if request.auth != null && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null && 'admin' in rolesDelUsuario();
    }

    // Mensajería ARTAL (comunicados de gerencia → equipo). CREAR/BORRAR solo lo puede el rol
    // 'comunicaciones' (Anny/Dylan; se suman más dándoles ese rol) o un admin. ACTUALIZAR lo puede
    // cualquiera que escriba, porque el receptor marca su acuse de recibo (acuses.{suEmail}) sobre
    // el mismo documento. La lectura la cubre el match general (el equipo ve lo que le corresponde;
    // el filtro por destinatario es en la app).
    match /mensajes/{id} {
      allow create: if request.auth != null && ('admin' in rolesDelUsuario() || 'comunicaciones' in rolesDelUsuario());
      allow update: if puedeEscribir();
      allow delete: if request.auth != null && ('admin' in rolesDelUsuario() || 'comunicaciones' in rolesDelUsuario());
    }

    // Notas personales: cada quien SOLO escribe/edita/borra las suyas (campo email == su correo).
    // La lectura la cubre el match general, pero la app filtra por email y nadie ve las de otro.
    match /notas/{id} {
      allow create: if request.auth != null && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null && resource.data.email == request.auth.token.email && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null && resource.data.email == request.auth.token.email;
    }

    // Recursos Humanos. En la UI el acceso es solo-admin (requireAuth([])), pero la LECTURA a
    // nivel de reglas la cubre el match /{document=**} de arriba (todo usuario con sesión). Si más
    // adelante hace falta ocultar sueldos al resto del equipo, habrá que restringir esa lectura
    // general y dar a rrhh* su propio `allow read: if 'admin' in rolesDelUsuario()`.
    match /rrhhEmpleados/{id}      { allow write: if puedeEscribir(); }
    match /rrhhDepartamentos/{id} { allow write: if puedeEscribir(); }
    match /rrhhCargos/{id}        { allow write: if puedeEscribir(); }
    match /rrhhSucursales/{id}    { allow write: if puedeEscribir(); }
    match /rrhhAsistencia/{id}    { allow write: if puedeEscribir(); }
    match /rrhhPermisos/{id}      { allow write: if puedeEscribir(); }
    match /rrhhTurnos/{id}        { allow write: if puedeEscribir(); }
    match /rrhhFeriados/{id}      { allow write: if puedeEscribir(); }
    match /rrhhFeriadosTrabajados/{fecha} { allow write: if puedeEscribir(); }   // feriado que SÍ se trabaja (lo marca gerencia en el comunicado de Mensajería)
    match /rrhhEventos/{id}       { allow write: if puedeEscribir(); }
    match /rrhhVacaciones/{id}    { allow write: if puedeEscribir(); }
    match /rrhhVacantes/{id}      { allow write: if puedeEscribir(); }
    match /rrhhCandidatos/{id}    { allow write: if puedeEscribir(); }
    match /rrhhConfig/{id}        { allow write: if puedeEscribir(); }
    match /partesDiarios/{id}     { allow write: if puedeEscribir(); }   // parte diario de obra (encargados de instalación)
    match /viajes/{id}            { allow write: if puedeEscribir(); }   // salidas del camión (Transportes): vehículo, ruta y costo repartido por obra
    match /informesObra/{id}      { allow write: if request.auth != null && 'admin' in rolesDelUsuario(); }   // los escribe la Cloud Function informeObraAlCompletar; admin puede corregir
    match /rrhhNominas/{id}       { allow write: if puedeEscribir(); }
    match /rrhhPrestamos/{id}     { allow write: if puedeEscribir(); }
    // Reuniones de seguimiento 1-a-1: SOLO gerencia (admin) crea/edita. El empleado las LEE (la
    // lectura la cubre el match general) y la app le muestra solo las suyas (por su correo).
    match /rrhhReuniones/{id}     { allow write: if request.auth != null && 'admin' in rolesDelUsuario(); }

    // Ventas / ERP comercial.
    match /ventasCotizaciones/{id} { allow write: if puedeEscribir(); }
    match /ventasOportunidades/{id} { allow write: if puedeEscribir(); }
    match /ventasVendedores/{id}    { allow write: if puedeEscribir(); }
    match /ventasComisiones/{id}    { allow write: if puedeEscribir(); }
    match /ventasListasPrecios/{id} { allow write: if puedeEscribir(); }
    match /ventasPrecioItems/{id}   { allow write: if puedeEscribir(); }
    match /ventasActividades/{id}   { allow write: if puedeEscribir(); }

    // Activos fijos.
    match /activos/{id}             { allow write: if puedeEscribir(); }
    match /activosPrestamos/{id}    { allow write: if puedeEscribir(); }

    // Producción (costeo y control de obra).
    match /produccionObras/{id}     { allow write: if puedeEscribir(); }

    // Productos y servicios (catálogo).
    match /productos/{id}           { allow write: if puedeEscribir(); }
    match /productosCategorias/{id} { allow write: if puedeEscribir(); }
    match /productosUnidades/{id}   { allow write: if puedeEscribir(); }
    match /productosImpuestos/{id}  { allow write: if puedeEscribir(); }

    // Bancos y tesorería.
    match /bancosCuentas/{id}         { allow write: if puedeEscribir(); }
    match /bancosMovimientos/{id}     { allow write: if puedeEscribir(); }
    match /bancosTransferencias/{id}  { allow write: if puedeEscribir(); }
    match /bancosCajaChica/{id}       { allow write: if puedeEscribir(); }
    match /bancosCajaMovimientos/{id} { allow write: if puedeEscribir(); }
    match /bancosCierres/{id}         { allow write: if puedeEscribir(); }
    match /bancosPrestamos/{id}       { allow write: if puedeEscribir(); }
    match /bancosLineas/{id}          { allow write: if puedeEscribir(); }
    match /bancosLineaMovimientos/{id} { allow write: if puedeEscribir(); }
    match /bancosTarjetas/{id}        { allow write: if puedeEscribir(); }
    match /bancosTarjetaMovimientos/{id} { allow write: if puedeEscribir(); }

    // Contabilidad operativa (la contabilidad formal/DGII vive en Citrus).
    match /contaMovimientos/{id}    { allow write: if puedeEscribir(); }
    match /contaCuentas/{id}        { allow write: if puedeEscribir(); }
    match /contaCategorias/{id}     { allow write: if puedeEscribir(); }
    match /contaPresupuestos/{id}   { allow write: if puedeEscribir(); }
    match /contaRecurrentes/{id}    { allow write: if puedeEscribir(); }
    match /contaCentros/{id}        { allow write: if puedeEscribir(); }
    match /catalogoCuentas/{id}     { allow write: if puedeEscribir(); }
    match /cotizacionesEspecificaciones/{id} { allow write: if puedeEscribir(); }

    // Solicitudes del sitio web: CREAR lo puede el público SIN sesión (validado arriba); un
    // visitante anónimo NO puede leer (la lectura de más arriba exige `request.auth != null`, así
    // que solo el equipo con sesión ve las solicitudes). Editar/borrar (marcar atendida, etc.)
    // requiere ser personal que pueda escribir.
    match /solicitudesWeb/{id} {
      allow update, delete: if puedeEscribir();
      allow create: if solicitudWebValida();
    }

    // ---------------------------------------------------------------------------------------
    // INBOX OMNICANAL (WhatsApp Cloud API + Instagram). Niveles: admin de la plataforma = Owner;
    // inbox_admin = Admin; inbox_supervisor; inbox_agente; inbox_lector/lector = solo lectura.
    // La LECTURA la cubre el match general (todo usuario con sesión). Los mensajes reales
    // (entrantes y salientes) los escribe SOLO el servidor (Cloud Functions con Admin SDK, que se
    // salta estas reglas): desde el navegador solo se pueden crear NOTAS INTERNAS. Así ningún
    // cliente web puede fabricar un "mensaje del cliente" ni marcar como enviado algo que no salió.
    function esInboxAdmin() {
      return request.auth != null && ('admin' in rolesDelUsuario() || 'inbox_admin' in rolesDelUsuario());
    }
    function puedeInbox() {
      return request.auth != null && (
        'admin' in rolesDelUsuario() || 'inbox_admin' in rolesDelUsuario()
        || 'inbox_supervisor' in rolesDelUsuario() || 'inbox_agente' in rolesDelUsuario());
    }
    match /inboxConversaciones/{id} {
      allow update: if puedeInbox();          // asignar, estado, prioridad, tags, leídos…
      allow create, delete: if false;         // solo el servidor crea; nunca se borran (historial)
    }
    match /inboxConversaciones/{id}/mensajes/{m} {
      allow create: if puedeInbox()
        && request.resource.data.is_internal_note == true
        && request.resource.data.sender_id == request.auth.token.email;
      allow update, delete: if false;
    }
    match /inboxConversaciones/{id}/eventos/{e} { allow create: if puedeInbox(); }   // timeline: solo crear
    match /inboxAuditoria/{id}                  { allow create: if request.auth != null && request.resource.data.actorEmail == request.auth.token.email; }   // nadie edita ni borra
    match /inboxContactos/{id}                  { allow create, update: if puedeInbox(); allow delete: if false; }
    match /inboxPresencia/{email}               { allow write: if request.auth != null && request.auth.token.email == email; }
    match /inboxEquipos/{id}                    { allow write: if esInboxAdmin(); }
    match /inboxTags/{id}                       { allow create: if puedeInbox(); allow update, delete: if esInboxAdmin(); }
    match /inboxReglas/{id}                     { allow write: if esInboxAdmin(); }
    match /inboxConfig/{id}                     { allow write: if esInboxAdmin(); }
    match /inboxCanales/{id}                    { allow write: if request.auth != null && 'admin' in rolesDelUsuario(); }   // solo Owner
    match /inboxRespuestasRapidas/{id} {
      allow create: if puedeInbox() && request.resource.data.email == request.auth.token.email && (request.resource.data.global == false || esInboxAdmin());
      allow update, delete: if esInboxAdmin() || (puedeInbox() && resource.data.email == request.auth.token.email && resource.data.global == false);
    }
    match /inboxPlantillas/{id}                 { allow write: if false; }   // las sincroniza el servidor desde Meta
    match /inboxFusiones/{id}                   { allow write: if false; }   // las escribe el servidor (fusión/deshacer)
    match /inboxEstadisticas/{id}               { allow write: if false; }
    match /inboxIndiceMensajes/{id}             { allow write: if false; }
    match /inboxContador/{id}                   { allow write: if false; }
  }
}
