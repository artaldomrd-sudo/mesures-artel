rules_version = '2';

// Reglas de seguridad de Firestore para el proyecto artal-operaciones.
// Se pegan en Firebase Console → Firestore Database → pestaña "Reglas" → Publicar.
//
// - Desde 2026-09-29 (bloqueo provisional por rol): lo operativo lo lee cualquier sesión; finanzas, RRHH,
//   ventas y puntos solo los roles de su grupo; la escritura va por grupo de rol (ver bloque de funciones).
//   El rol vive en usuarios/{email}.rol y puede ser un string ('chofer') o un array (['chofer',...]).
// - Los registros de auditoría (movimientosInstalaciones, movimientosInventario) solo permiten
//   CREAR: una anotación ya hecha no se puede editar ni borrar (ni siquiera un admin) — historial
//   a prueba de manipulación. Por eso las colecciones se enumeran una por una en vez de usar un
//   `allow write` recursivo (que dejaría editar/borrar el log).
service cloud.firestore {
  match /databases/{database}/documents {

    function rolesDelUsuario() {
      let u = get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data;
      return u.rol is list ? u.rol : [u.rol];
    }
    function puedeEscribir() {
      return request.auth != null
        && ('admin' in rolesDelUsuario() || !('lector' in rolesDelUsuario()));
    }

    // Solicitud del formulario del sitio web: la crea el público SIN sesión, así que se valida a
    // mano (solo los campos esperados, con tipos y tamaños acotados) para no dejar entrar basura.
    function solicitudWebValida() {
      let d = request.resource.data;
      return d.origen == 'web'
        && d.estado == 'nueva'
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() < 120
        && d.telefono is string && d.telefono.size() < 40
        && d.email is string && d.email.size() < 160
        && d.tipo is string && d.tipo.size() < 200
        && d.mensaje is string && d.mensaje.size() < 3000
        && d.keys().hasOnly(['origen','estado','nombre','telefono','email','tipo','mensaje','fecha']);
    }

    // ==========================================================================================
    // BLOQUEO PROVISIONAL POR ROL (usuario 2026-09-29: «cada quien solo puede ver lo que le pertenece»).
    // Antes: todo usuario con sesión leía TODO (bancos, nómina, sueldos) y cualquiera que no fuera lector
    // escribía en cualquier colección. Ahora la lectura y la escritura van por GRUPOS de rol. Es una
    // primera capa (provisional); la seguridad fina (por documento/campo) vendrá después.
    //   finanzas  = admin, contable                  → bancos*, conta*, activos*, informes de costo, nómina
    //   rrhh      = admin, contable                  → rrhh* (empleados, permisos, eventos, reclutamiento…)
    //   ventas    = admin, cotizaciones, contable    → ventas*, productos*, producción, calculadores
    //   oficina   = admin, contable, cotizaciones, comunicaciones → gestión del día a día (pedidos, agenda…)
    //   obra      = admin, instalador, ayudante, chofer            → pedidos, agenda, inventario, partes
    // Lo operativo y no sensible (pedidos, agenda, clientes, equipo, mensajes, academia, feriados) lo lee
    // cualquier sesión. `puntos` (beta) lo lee SOLO admin. `usuarios` como antes (propio o admin).
    // ==========================================================================================
    function alguno(rs) { return request.auth != null && rolesDelUsuario().hasAny(rs); }
    function esAdmin()  { return alguno(['admin']); }
    function finanzas() { return alguno(['admin', 'contable']); }
    function rrhh()     { return alguno(['admin', 'contable']); }
    function ventas()   { return alguno(['admin', 'cotizaciones', 'contable']); }
    function oficina()  { return alguno(['admin', 'contable', 'cotizaciones', 'comunicaciones']); }
    function obra()     { return alguno(['admin', 'instalador', 'ayudante', 'chofer']); }
    function operativo(){ return oficina() || obra() || alguno(['fabrica', 'contratista']); }

    // --- Lectura general: solo lo operativo y no sensible. Todo lo demás se declara abajo colección por colección.
    match /{coleccion}/{resto=**} {
      allow read: if request.auth != null && coleccion in [
        'orders', 'instalaciones', 'citas', 'clientes', 'equipo', 'mensajes', 'notas',
        'inventario', 'categoriasInventario', 'subgruposInventario', 'bultosHerramientas', 'equiposInstalacion',
        'movimientosInventario', 'movimientosInstalaciones',
        'academiaCursos', 'academiaLecciones', 'academiaProgreso',
        'puntosConfig', 'rrhhFeriados', 'rrhhFeriadosTrabajados', 'rrhhTurnos', 'rrhhConfig',
        'rrhhDepartamentos', 'rrhhCargos', 'rrhhSucursales',
        'proyectosGuardados', 'calculadores', 'cotizacionesEspecificaciones', 'productosUnidades', 'tasas'
      ];
    }
    match /equipo/{email} {
      allow write: if false;   // solo la Cloud Function sincronizarEquipo (Admin SDK)
    }

    // Precios de combustible (MICM): los actualiza una Cloud Function. Lectura PÚBLICA (precios oficiales) para que
    // la calculadora de transporte del cuaderno los lea aunque no haya sesión. Ningún cliente escribe aquí.
    match /config/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /tablero/{id}                  { allow read: if ventas(); allow write: if false; }
    match /citrusSync/{id}               { allow read: if finanzas(); allow write: if false; }
    match /citrusCotizacionesPanel/{id}  { allow read: if ventas(); allow write: if false; }
    match /proveedores/{id}              { allow read: if finanzas(); allow write: if finanzas(); }

    // Registros de auditoría: SOLO se pueden CREAR. Nadie (ni admin) edita ni borra una anotación ya hecha.
    match /movimientosInstalaciones/{id} { allow create: if oficina() || obra(); }
    match /movimientosInventario/{id}    { allow create: if oficina() || obra(); }
    // Papelera (2026-09-28): copia completa de cada trabajo/recordatorio/cita/pedido borrado, con quién y cuándo
    // (ops/papelera.js). Solo CREAR; la LEE solo admin (contiene copias de cualquier documento).
    match /papelera/{id}                 { allow read: if esAdmin(); allow create: if operativo(); }

    // --- Operación del día a día.
    match /orders/{id}               { allow write: if operativo(); }
    match /citas/{id}                { allow write: if oficina() || obra(); }
    match /instalaciones/{id}        { allow write: if oficina() || obra(); }
    match /inventario/{id}           { allow write: if oficina() || obra(); }
    match /categoriasInventario/{id} { allow write: if oficina() || obra(); }
    match /subgruposInventario/{id}  { allow write: if oficina() || obra(); }
    match /bultosHerramientas/{id}   { allow write: if oficina() || obra(); }
    match /clientes/{id}             { allow write: if oficina() || obra(); }
    match /equiposInstalacion/{id}   { allow write: if oficina() || alguno(['instalador']); }
    match /viajes/{id}               { allow read: if finanzas() || alguno(['chofer']); allow write: if alguno(['admin', 'chofer']); }   // salidas del camión con costo por obra
    // Parte diario (horas y costo/hora por persona): encargados (instalador), oficina y finanzas. Ayudante/chofer no lo leen.
    match /partesDiarios/{id}        { allow read: if finanzas() || oficina() || alguno(['instalador']); allow write: if oficina() || alguno(['instalador']); }
    match /informesObra/{id}         { allow read: if finanzas(); allow write: if esAdmin(); }   // los escribe la Cloud Function; admin corrige
    // Usuarios y roles: CREAR/BORRAR y cambiar rol/nombre/activo solo un ADMIN (pantalla
    // usuarios.html). Cada persona puede actualizar SU propio documento solo en sus ajustes
    // personales (fcmToken, panelOrden, notifOcultas, PIN, biometría…), nunca su rol ni su estado.
    match /usuarios/{email} {
      allow read: if request.auth != null && (request.auth.token.email == email || 'admin' in rolesDelUsuario());
      allow create, delete: if request.auth != null && 'admin' in rolesDelUsuario();
      allow update: if request.auth != null && (
        'admin' in rolesDelUsuario()
        || (request.auth.token.email == email
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['rol', 'activo', 'nombre', 'paginasExtra', 'paginasBloqueadas'])));
    }
    match /proyectosGuardados/{id}   { allow write: if puedeEscribir(); }   // cuaderno de medidas (cualquier sesión que no sea lector)
    // Historial de versiones del cuaderno (proyectosGuardados/{id}/versiones/{ts}): la escritura NO se hereda del padre.
    match /proyectosGuardados/{id}/versiones/{v} { allow write: if puedeEscribir(); }

    // Academia (capacitación): el CONTENIDO (cursos/lecciones) solo lo edita gerencia (admin) o el
    // rol 'capacitador'. El PROGRESO lo escribe cada quien sobre su propio avance (cualquier sesión).
    match /academiaCursos/{id}    { allow write: if request.auth != null && ('admin' in rolesDelUsuario() || 'capacitador' in rolesDelUsuario()); }
    match /academiaLecciones/{id} { allow write: if request.auth != null && ('admin' in rolesDelUsuario() || 'capacitador' in rolesDelUsuario()); }
    match /academiaProgreso/{id}  { allow write: if request.auth != null; }

    // Puntos (gamificación, BETA no visible para el equipo — usuario 2026-09-29): SOLO admin lee. La Academia crea
    // eventos con el correo propio (tipo academia); el resto los escribe la Cloud Function. Borrar, solo admin.
    match /puntos/{id} {
      allow read: if esAdmin();
      allow create: if request.auth != null && (request.resource.data.email == request.auth.token.email || esAdmin());
      allow update, delete: if esAdmin();
    }
    // Valoraciones entre el equipo (2026-09-27), SIEMPRE anónimas entre ellos: `valoracionesEquipo`
    // (encargado → cada persona, desde la ventana de horas al completar) y `valoracionesEncargado`
    // (cada persona → su encargado, desde la tarjeta del trabajo). Solo las lee gerencia (admin) o quien
    // la escribió (`por` = su correo); cada quien crea/edita solo las suyas y nunca sobre sí mismo. Los
    // puntos los aplica la Cloud Function sin nombrar a nadie. Borrar, solo admin.
    function valoracionPropia() {
      return request.auth != null
        && request.resource.data.por == request.auth.token.email
        && request.resource.data.nivel in ['bien', 'ok', 'flojo']
        && (!('email' in request.resource.data) || request.resource.data.email != request.auth.token.email)
        && (!('para' in request.resource.data) || request.resource.data.para != request.auth.token.email);
    }
    match /valoracionesEquipo/{id} {
      allow read: if request.auth != null && ('admin' in rolesDelUsuario() || resource.data.por == request.auth.token.email);
      allow create, update: if valoracionPropia();
      allow delete: if request.auth != null && 'admin' in rolesDelUsuario();
    }
    match /valoracionesEncargado/{id} {
      allow read: if request.auth != null && ('admin' in rolesDelUsuario() || resource.data.por == request.auth.token.email);
      allow create, update: if valoracionPropia();
      allow delete: if request.auth != null && 'admin' in rolesDelUsuario();
    }
    // Reglas/valores del sistema de puntos (visibleEquipo, desde, puntos por evento): solo admin.
    match /puntosConfig/{id} { allow write: if request.auth != null && 'admin' in rolesDelUsuario(); }
    // Encuesta de satisfacción del cliente (ops/satisfaccion.html?t=TOKEN): la crea la Cloud Function
    // al completarse un trabajo. El CLIENTE la abre SIN sesión: puede leer SU encuesta (por el token,
    // que es el id del doc; no puede listar) y responderla UNA vez — solo pasa de 'pendiente' a
    // 'respondida' escribiendo el mapa `respuesta` con campos acotados. Nadie edita una respuesta.
    function respuestaEncuestaValida() {
      let r = request.resource.data.respuesta;
      return resource.data.estado == 'pendiente'
        && request.resource.data.estado == 'respondida'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'respuesta'])
        && r is map
        && r.general is int && r.general >= 1 && r.general <= 5
        && r.comentario is string && r.comentario.size() <= 1500
        && r.keys().hasOnly(['general', 'puntualidad', 'limpieza', 'trato', 'recomendaria', 'comentario', 'nombre', 'idioma', 'fecha']);
    }
    match /encuestas/{token} {
      allow get: if true;
      allow list: if esAdmin();
      allow update: if respuestaEncuestaValida() || (request.auth != null && 'admin' in rolesDelUsuario());
      allow create, delete: if request.auth != null && 'admin' in rolesDelUsuario();
    }

    // Mensajería ARTAL (comunicados de gerencia → equipo). CREAR/BORRAR solo lo puede el rol
    // 'comunicaciones' (Anny/Dylan; se suman más dándoles ese rol) o un admin. ACTUALIZAR lo puede
    // cualquiera que escriba, porque el receptor marca su acuse de recibo (acuses.{suEmail}) sobre
    // el mismo documento. La lectura la cubre el match general (el equipo ve lo que le corresponde;
    // el filtro por destinatario es en la app).
    match /mensajes/{id} {
      allow create: if alguno(['admin', 'comunicaciones', 'capacitador']);   // capacitador: aviso de curso nuevo (Academia)
      // El receptor solo marca SU acuse (acuses.{suClave}); el cuerpo lo editan admin/comunicaciones.
      allow update: if alguno(['admin', 'comunicaciones'])
        || (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acuses']));
      allow delete: if alguno(['admin', 'comunicaciones']);
    }

    // Notas personales: cada quien SOLO escribe/edita/borra las suyas (campo email == su correo).
    // La lectura la cubre el match general, pero la app filtra por email y nadie ve las de otro.
    match /notas/{id} {
      allow create: if request.auth != null && request.resource.data.email == request.auth.token.email;
      allow update: if request.auth != null && resource.data.email == request.auth.token.email && request.resource.data.email == request.auth.token.email;
      allow delete: if request.auth != null && resource.data.email == request.auth.token.email;
    }

    // Recursos Humanos: LEER y ESCRIBIR solo finanzas/RRHH (admin, contable). Excepciones operativas:
    // rrhhEmpleados lo leen también los encargados (instalador) porque el parte diario y la ventana de horas necesitan
    // nombre/correo/costo por día (pendiente: mover el costo al servidor); rrhhAsistencia recibe la AUSENCIA que marca el
    // encargado en el parte; feriados/turnos/config/departamentos/cargos/sucursales se leen en general (arriba);
    // rrhhReuniones: el empleado lee las suyas. La nómina la lleva la contable.
    match /rrhhEmpleados/{id}      { allow read: if rrhh() || alguno(['instalador']); allow write: if rrhh(); }
    match /rrhhDepartamentos/{id} { allow write: if rrhh(); }
    match /rrhhCargos/{id}        { allow write: if rrhh(); }
    match /rrhhSucursales/{id}    { allow write: if rrhh(); }
    match /rrhhAsistencia/{id}    { allow read: if rrhh(); allow write: if rrhh() || alguno(['instalador']); }
    match /rrhhPermisos/{id}      { allow read, write: if rrhh(); }
    match /rrhhTurnos/{id}        { allow write: if rrhh(); }
    match /rrhhFeriados/{id}      { allow write: if rrhh(); }
    match /rrhhFeriadosTrabajados/{fecha} { allow write: if alguno(['admin', 'comunicaciones']); }   // feriado que SÍ se trabaja (comunicado)
    match /rrhhEventos/{id}       { allow read, write: if rrhh(); }
    match /rrhhVacaciones/{id}    { allow read, write: if rrhh(); }
    match /rrhhVacantes/{id}      { allow read, write: if rrhh(); }
    match /rrhhCandidatos/{id}    { allow read, write: if rrhh(); }
    match /rrhhConfig/{id}        { allow write: if esAdmin(); }
    match /rrhhNominas/{id}       { allow read, write: if finanzas(); }
    match /rrhhPrestamos/{id}     { allow read, write: if finanzas(); }
    match /rrhhReuniones/{id} {
      allow read: if rrhh() || (request.auth != null && resource.data.empleadoCorreo == request.auth.token.email);
      allow write: if esAdmin();
    }

    // Ventas / ERP comercial: admin, cotizaciones, contable.
    match /ventasCotizaciones/{id}  { allow read, write: if ventas(); }
    match /ventasOportunidades/{id} { allow read, write: if ventas(); }
    match /ventasVendedores/{id}    { allow read, write: if ventas(); }
    match /ventasComisiones/{id}    { allow read, write: if ventas(); }
    match /ventasListasPrecios/{id} { allow read, write: if ventas(); }
    match /ventasPrecioItems/{id}   { allow read, write: if ventas(); }
    match /ventasActividades/{id}   { allow read, write: if ventas(); }

    // Activos fijos: finanzas.
    match /activos/{id}             { allow read, write: if finanzas(); }
    match /activosPrestamos/{id}    { allow read, write: if finanzas(); }

    // Producción (costeo y control de obra): ventas + finanzas.
    match /produccionObras/{id}     { allow read, write: if ventas(); }

    // Productos y servicios (catálogo): ventas. Las unidades las lee todo el mundo (cuaderno).
    match /productos/{id}           { allow read, write: if ventas(); }
    match /productosCategorias/{id} { allow read, write: if ventas(); }
    match /productosUnidades/{id}   { allow write: if ventas(); }
    match /productosImpuestos/{id}  { allow read, write: if ventas(); }

    // Bancos y tesorería: SOLO finanzas (admin, contable).
    match /bancosCuentas/{id}         { allow read, write: if finanzas(); }
    match /bancosMovimientos/{id}     { allow read, write: if finanzas(); }
    match /bancosTransferencias/{id}  { allow read, write: if finanzas(); }
    match /bancosCajaChica/{id}       { allow read, write: if finanzas(); }
    match /bancosCajaMovimientos/{id} { allow read, write: if finanzas(); }
    match /bancosCierres/{id}         { allow read, write: if finanzas(); }
    match /bancosPrestamos/{id}       { allow read, write: if finanzas(); }
    match /bancosLineas/{id}          { allow read, write: if finanzas(); }
    match /bancosLineaMovimientos/{id} { allow read, write: if finanzas(); }
    match /bancosTarjetas/{id}        { allow read, write: if finanzas(); }
    match /bancosTarjetaMovimientos/{id} { allow read, write: if finanzas(); }

    // Contabilidad operativa (la formal/DGII vive en Citrus): SOLO finanzas.
    match /contaMovimientos/{id}    { allow read, write: if finanzas(); }
    match /contaCuentas/{id}        { allow read, write: if finanzas(); }
    match /contaCategorias/{id}     { allow read, write: if finanzas(); }
    match /contaPresupuestos/{id}   { allow read, write: if finanzas(); }
    match /contaRecurrentes/{id}    { allow read, write: if finanzas(); }
    match /contaCentros/{id}        { allow read, write: if finanzas(); }
    match /catalogoCuentas/{id}     { allow read, write: if finanzas(); }
    match /cotizacionesEspecificaciones/{id} { allow write: if ventas(); }
    match /calculadores/{id}      { allow write: if ventas(); }   // parámetros compartidos de los calculadores (rollo de tela mosquitera, precio por m²…)

    // Solicitudes del sitio web: CREAR lo puede el público SIN sesión (validado arriba); un
    // visitante anónimo NO puede leer (la lectura de más arriba exige `request.auth != null`, así
    // que solo el equipo con sesión ve las solicitudes). Editar/borrar (marcar atendida, etc.)
    // requiere ser personal que pueda escribir.
    match /solicitudesWeb/{id} {
      allow read: if oficina();
      allow update, delete: if oficina();
      allow create: if solicitudWebValida();
    }

    // ---------------------------------------------------------------------------------------
    // INBOX OMNICANAL (WhatsApp Cloud API + Instagram). Niveles: admin de la plataforma = Owner;
    // inbox_admin = Admin; inbox_supervisor; inbox_agente; inbox_lector/lector = solo lectura.
    // La LECTURA la cubre el match general (todo usuario con sesión). Los mensajes reales
    // (entrantes y salientes) los escribe SOLO el servidor (Cloud Functions con Admin SDK, que se
    // salta estas reglas): desde el navegador solo se pueden crear NOTAS INTERNAS. Así ningún
    // cliente web puede fabricar un "mensaje del cliente" ni marcar como enviado algo que no salió.
    function esInboxAdmin() {
      return request.auth != null && ('admin' in rolesDelUsuario() || 'inbox_admin' in rolesDelUsuario());
    }
    function puedeInbox() {
      return request.auth != null && (
        'admin' in rolesDelUsuario() || 'inbox_admin' in rolesDelUsuario()
        || 'inbox_supervisor' in rolesDelUsuario() || 'inbox_agente' in rolesDelUsuario());
    }
    match /{inboxCol}/{resto=**} {
      allow read: if inboxCol.matches('inbox.*') && (puedeInbox() || alguno(['inbox_lector', 'lector']));
    }
    match /inboxConversaciones/{id} {
      allow update: if puedeInbox();          // asignar, estado, prioridad, tags, leídos…
      allow create, delete: if false;         // solo el servidor crea; nunca se borran (historial)
    }
    match /inboxConversaciones/{id}/mensajes/{m} {
      allow create: if puedeInbox()
        && request.resource.data.is_internal_note == true
        && request.resource.data.sender_id == request.auth.token.email;
      allow update, delete: if false;
    }
    match /inboxConversaciones/{id}/eventos/{e} { allow create: if puedeInbox(); }   // timeline: solo crear
    match /inboxAuditoria/{id}                  { allow create: if request.auth != null && request.resource.data.actorEmail == request.auth.token.email; }   // nadie edita ni borra
    match /inboxContactos/{id}                  { allow create, update: if puedeInbox(); allow delete: if false; }
    match /inboxPresencia/{email}               { allow write: if request.auth != null && request.auth.token.email == email; }
    match /inboxEquipos/{id}                    { allow write: if esInboxAdmin(); }
    match /inboxTags/{id}                       { allow create: if puedeInbox(); allow update, delete: if esInboxAdmin(); }
    match /inboxReglas/{id}                     { allow write: if esInboxAdmin(); }
    match /inboxConfig/{id}                     { allow write: if esInboxAdmin(); }
    match /inboxCanales/{id}                    { allow write: if request.auth != null && 'admin' in rolesDelUsuario(); }   // solo Owner
    match /inboxRespuestasRapidas/{id} {
      allow create: if puedeInbox() && request.resource.data.email == request.auth.token.email && (request.resource.data.global == false || esInboxAdmin());
      allow update, delete: if esInboxAdmin() || (puedeInbox() && resource.data.email == request.auth.token.email && resource.data.global == false);
    }
    match /inboxPlantillas/{id}                 { allow write: if false; }   // las sincroniza el servidor desde Meta
    match /inboxFusiones/{id}                   { allow write: if false; }   // las escribe el servidor (fusión/deshacer)
    match /inboxEstadisticas/{id}               { allow write: if false; }
    match /inboxIndiceMensajes/{id}             { allow write: if false; }
    match /inboxContador/{id}                   { allow write: if false; }
  }
}
