rules_version = '2';

// Reglas de seguridad de Firestore para el proyecto artal-operaciones.
// Se pegan en Firebase Console → Firestore Database → pestaña "Reglas" → Publicar.
//
// - Todo usuario autenticado puede LEER.
// - Escriben todos EXCEPTO quien tenga el rol `lector` (a menos que también sea `admin`). El rol
//   vive en usuarios/{email}.rol y puede ser un string ('chofer') o un array (['chofer',...]).
// - Los registros de auditoría (movimientosInstalaciones, movimientosInventario) solo permiten
//   CREAR: una anotación ya hecha no se puede editar ni borrar (ni siquiera un admin) — historial
//   a prueba de manipulación. Por eso las colecciones se enumeran una por una en vez de usar un
//   `allow write` recursivo (que dejaría editar/borrar el log).
service cloud.firestore {
  match /databases/{database}/documents {

    function rolesDelUsuario() {
      let u = get(/databases/$(database)/documents/usuarios/$(request.auth.token.email)).data;
      return u.rol is list ? u.rol : [u.rol];
    }
    function puedeEscribir() {
      return request.auth != null
        && ('admin' in rolesDelUsuario() || !('lector' in rolesDelUsuario()));
    }

    // Solicitud del formulario del sitio web: la crea el público SIN sesión, así que se valida a
    // mano (solo los campos esperados, con tipos y tamaños acotados) para no dejar entrar basura.
    function solicitudWebValida() {
      let d = request.resource.data;
      return d.origen == 'web'
        && d.estado == 'nueva'
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() < 120
        && d.telefono is string && d.telefono.size() < 40
        && d.email is string && d.email.size() < 160
        && d.tipo is string && d.tipo.size() < 200
        && d.mensaje is string && d.mensaje.size() < 3000
        && d.keys().hasOnly(['origen','estado','nombre','telefono','email','tipo','mensaje','fecha']);
    }

    // Todo se puede LEER estando autenticado.
    match /{document=**} {
      allow read: if request.auth != null;
    }

    // Registros de auditoría: SOLO se pueden CREAR. Nadie (ni admin) edita ni borra una anotación
    // ya hecha — historial a prueba de manipulación.
    match /movimientosInstalaciones/{id} { allow create: if puedeEscribir(); }
    match /movimientosInventario/{id}    { allow create: if puedeEscribir(); }

    // Colecciones normales: crear / editar / borrar para quien no sea "lector".
    match /orders/{id}               { allow write: if puedeEscribir(); }
    match /citas/{id}                { allow write: if puedeEscribir(); }
    match /instalaciones/{id}        { allow write: if puedeEscribir(); }
    match /inventario/{id}           { allow write: if puedeEscribir(); }
    match /categoriasInventario/{id} { allow write: if puedeEscribir(); }
    match /subgruposInventario/{id}  { allow write: if puedeEscribir(); }
    match /bultosHerramientas/{id}   { allow write: if puedeEscribir(); }
    match /clientes/{id}             { allow write: if puedeEscribir(); }
    match /usuarios/{id}             { allow write: if puedeEscribir(); }
    match /proyectosGuardados/{id}   { allow write: if puedeEscribir(); }

    // Recursos Humanos. En la UI el acceso es solo-admin (requireAuth([])), pero la LECTURA a
    // nivel de reglas la cubre el match /{document=**} de arriba (todo usuario con sesión). Si más
    // adelante hace falta ocultar sueldos al resto del equipo, habrá que restringir esa lectura
    // general y dar a rrhh* su propio `allow read: if 'admin' in rolesDelUsuario()`.
    match /rrhhEmpleados/{id}      { allow write: if puedeEscribir(); }
    match /rrhhDepartamentos/{id} { allow write: if puedeEscribir(); }
    match /rrhhCargos/{id}        { allow write: if puedeEscribir(); }
    match /rrhhSucursales/{id}    { allow write: if puedeEscribir(); }
    match /rrhhAsistencia/{id}    { allow write: if puedeEscribir(); }
    match /rrhhPermisos/{id}      { allow write: if puedeEscribir(); }
    match /rrhhTurnos/{id}        { allow write: if puedeEscribir(); }
    match /rrhhFeriados/{id}      { allow write: if puedeEscribir(); }
    match /rrhhEventos/{id}       { allow write: if puedeEscribir(); }
    match /rrhhVacaciones/{id}    { allow write: if puedeEscribir(); }
    match /rrhhVacantes/{id}      { allow write: if puedeEscribir(); }
    match /rrhhCandidatos/{id}    { allow write: if puedeEscribir(); }
    match /rrhhConfig/{id}        { allow write: if puedeEscribir(); }
    match /rrhhNominas/{id}       { allow write: if puedeEscribir(); }
    match /rrhhPrestamos/{id}     { allow write: if puedeEscribir(); }

    // Ventas / ERP comercial.
    match /ventasCotizaciones/{id} { allow write: if puedeEscribir(); }
    match /ventasOportunidades/{id} { allow write: if puedeEscribir(); }
    match /ventasVendedores/{id}    { allow write: if puedeEscribir(); }
    match /ventasComisiones/{id}    { allow write: if puedeEscribir(); }
    match /ventasListasPrecios/{id} { allow write: if puedeEscribir(); }
    match /ventasPrecioItems/{id}   { allow write: if puedeEscribir(); }
    match /ventasActividades/{id}   { allow write: if puedeEscribir(); }

    // Activos fijos.
    match /activos/{id}             { allow write: if puedeEscribir(); }
    match /activosPrestamos/{id}    { allow write: if puedeEscribir(); }

    // Producción (costeo y control de obra).
    match /produccionObras/{id}     { allow write: if puedeEscribir(); }

    // Productos y servicios (catálogo).
    match /productos/{id}           { allow write: if puedeEscribir(); }
    match /productosCategorias/{id} { allow write: if puedeEscribir(); }
    match /productosUnidades/{id}   { allow write: if puedeEscribir(); }
    match /productosImpuestos/{id}  { allow write: if puedeEscribir(); }

    // Bancos y tesorería.
    match /bancosCuentas/{id}         { allow write: if puedeEscribir(); }
    match /bancosMovimientos/{id}     { allow write: if puedeEscribir(); }
    match /bancosTransferencias/{id}  { allow write: if puedeEscribir(); }
    match /bancosCajaChica/{id}       { allow write: if puedeEscribir(); }
    match /bancosCajaMovimientos/{id} { allow write: if puedeEscribir(); }
    match /bancosCierres/{id}         { allow write: if puedeEscribir(); }
    match /bancosPrestamos/{id}       { allow write: if puedeEscribir(); }
    match /bancosLineas/{id}          { allow write: if puedeEscribir(); }
    match /bancosLineaMovimientos/{id} { allow write: if puedeEscribir(); }
    match /bancosTarjetas/{id}        { allow write: if puedeEscribir(); }
    match /bancosTarjetaMovimientos/{id} { allow write: if puedeEscribir(); }

    // Contabilidad operativa (la contabilidad formal/DGII vive en Citrus).
    match /contaMovimientos/{id}    { allow write: if puedeEscribir(); }
    match /contaCuentas/{id}        { allow write: if puedeEscribir(); }
    match /contaCategorias/{id}     { allow write: if puedeEscribir(); }
    match /contaPresupuestos/{id}   { allow write: if puedeEscribir(); }
    match /contaRecurrentes/{id}    { allow write: if puedeEscribir(); }
    match /contaCentros/{id}        { allow write: if puedeEscribir(); }
    match /cotizacionesEspecificaciones/{id} { allow write: if puedeEscribir(); }

    // Solicitudes del sitio web: CREAR lo puede el público SIN sesión (validado arriba); un
    // visitante anónimo NO puede leer (la lectura de más arriba exige `request.auth != null`, así
    // que solo el equipo con sesión ve las solicitudes). Editar/borrar (marcar atendida, etc.)
    // requiere ser personal que pueda escribir.
    match /solicitudesWeb/{id} {
      allow update, delete: if puedeEscribir();
      allow create: if solicitudWebValida();
    }
  }
}
